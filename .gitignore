# Node dependencies
node_modules/
frontend/node_modules/
backend/frontend/node_modules/
frontend/dist/
backend/frontend/dist/
dev.log
*.log
*.log.err

# Firebase service-account private keys - never commit these.
*service-account*.json
*firebase*.json
backend/firebase/

# Python Virtual Environment & Caches
backend/ml-service/venv/
.venv/
__pycache__/
*.pyc
backend/ml-service/.pytest_cache/
backend/ml-service/.cache/
backend/ml-service/*.pth
backend/ml-service/*.pt
backend/ml-service/weights/*.pth
backend/ml-service/weights/*.h5
backend/ml-service/weights/*.joblib
backend/ml-service/weights/*.pkl
backend/ml-service/weights/*.csv
backend/ml-service/reports/*.pdf
backend/ml-service/temp_heatmaps/*
backend/ml-service/*.log
backend/ml-service/*.log.err

# Measured accuracy results ARE tracked: they are the evidence behind every
# performance claim, and they are only a few KB each.
!backend/ml-service/weights/*.metrics.json

# Downloaded upstream project archives (source repos, hundreds of MB).
# Fetch model weights with `python ml-service/fetch_weights.py` instead.
*.zip

