{
  "name": "mediscan-ai",
  "private": true,
  "version": "0.1.0",
  "description": "MediScan AI - multi-disease CNN screening platform (ML service + Spring Boot + React)",
  "scripts": {
    "predev": "node scripts/free-ports.mjs",
    "dev": "concurrently --names \"ML,API,WEB\" --prefix-colors \"magenta.bold,cyan.bold,green.bold\" --kill-others-on-fail \"npm:dev:ml\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:ml": "cd ml-service && venv\\Scripts\\python.exe -m uvicorn app:app --port 8001",
    "stop": "node scripts/free-ports.mjs",
    "dev:api": "cd backend && gradlew.bat bootRun --console=plain -q",
    "dev:web": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "test": "npm run test:ml && npm run test:api",
    "test:ml": "cd ml-service && venv\\Scripts\\python.exe -m pytest tests -q",
    "test:api": "cd backend && gradlew.bat test --console=plain",
    "lint": "cd frontend && npm run lint",
    "setup": "npm install && cd frontend && npm install",
    "weights": "cd ml-service && venv\\Scripts\\python.exe fetch_weights.py",
    "evaluate": "cd ml-service && venv\\Scripts\\python.exe evaluate.py --all --limit 300",
    "health": "node scripts/health.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
