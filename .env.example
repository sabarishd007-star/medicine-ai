# Copy to .env and replace every placeholder before starting the stack.
POSTGRES_DB=mediscan_db
POSTGRES_USER=mediscan_admin
POSTGRES_PASSWORD=replace_with_a_long_unique_database_password

# The same random value is passed to Spring and FastAPI for private gateway calls.
MEDISCAN_GATEWAY_SHARED_SECRET=replace_with_a_random_32_plus_character_secret

# Optional integrations. Leave blank when not in use.
MEDISCAN_ASSISTANT_API_KEY=
PACS_DICOMWEB_URL=
PACS_OAUTH_TOKEN=
